// app.rc — Windows resource script
// Embeds the application icon and version information into folder_colorizer.exe

#include <windows.h>

// ── Application icon ─────────────────────────────────────────────────────────
// Icon resource ID 1 is loaded as the default app icon (WM_GETICON, taskbar, etc.)
1 ICON "..\icons\orange.ico"

// ── Version information ───────────────────────────────────────────────────────
VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"   // English (US), Unicode
        BEGIN
            VALUE "CompanyName",      "walidroid\0"
            VALUE "FileDescription",  "Folder Colorizer — change folder icon colours\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "folder_colorizer\0"
            VALUE "LegalCopyright",   "© 2025 walidroid\0"
            VALUE "OriginalFilename", "folder_colorizer.exe\0"
            VALUE "ProductName",      "Folder Colorizer\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
